# Server Configuration
PORT=5000
NODE_ENV=development

# Database (PostgreSQL 16 with PostGIS)
DATABASE_URL=postgresql://bhumisetu_user:bhumisetu_password@localhost:5432/bhumisetu_db

# Redis (BullMQ & Cache)
REDIS_URL=redis://localhost:6379

# Hugging Face AI Endpoint Configuration
HUGGINGFACE_API_KEY=hf_your_token_here
HUGGINGFACE_ENDPOINT_URL=https://api-inference.huggingface.co/models/microsoft/trocr-base-stage1
# Set USE_HF_MOCK=true to use deterministic mock OCR output during offline testing or development
USE_HF_MOCK=true

# Storage (MinIO or AWS S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=bhumisetu-documents
S3_FORCE_PATH_STYLE=true

# Security & Authentication
JWT_SECRET=bhumisetu-production-secret-key-change-this-in-prod-2026
JWT_EXPIRES_IN=24h
