# Server Configuration
PORT=5000
NODE_ENV=development

# Database (PostgreSQL 16 with PostGIS)
DATABASE_URL=postgresql://bhumisetu_user:bhumisetu_password@localhost:5432/bhumisetu_db

# Redis (BullMQ & Cache)
REDIS_URL=redis://localhost:6379

# AI Pipeline Dual-Mode Engine Configuration
# Available Modes:
#   LLM          - Cloud Vision LLM (Gemini 1.5 Flash/Pro) for instant high-precision multi-language extraction [ACTIVE DEFAULT]
#   LOCAL_MODEL  - On-premise fine-tuned Indic model (Qwen2-VL / TrOCR) via Hugging Face Inference Endpoint [OFFLINE/EDGE]
#   HYBRID       - Runs local model first; automatically escalates to Vision LLM if confidence < threshold
#   MOCK         - Offline deterministic test mock (runs without any API keys or network)
AI_MODE=LLM

# Google Gemini Vision Configuration (Get free key from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Hugging Face AI Endpoint Configuration (Fine-Tuned Land Record Model)
HUGGINGFACE_API_KEY=hf_your_token_here
HUGGINGFACE_ENDPOINT_URL=https://api-inference.huggingface.co/models/YOUR_USERNAME/bhumisetu-qwen2-vl-handwriting
USE_HF_MOCK=false

# Hybrid Fallback Confidence Threshold (0.0 to 1.0)
HYBRID_CONFIDENCE_THRESHOLD=0.70

# Storage (MinIO or AWS S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=bhumisetu-documents
S3_FORCE_PATH_STYLE=true

# Security & Authentication
JWT_SECRET=bhumisetu-production-secret-key-change-this-in-prod-2026
JWT_EXPIRES_IN=24h

# Sarvam AI Sovereign Vision & Doc Intelligence
AI_PROVIDER=SARVAM
SARVAM_API_KEY=your_sarvam_api_key_here
